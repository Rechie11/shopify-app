{%- comment -%}
  Renders an <img> with srcset/sizes off Shopify's CDN, explicit width/height
  to reserve layout space, and lazy loading by default. See THEME_SPEC.md §7.
  Accepts:
    image (required)     - image object
    sizes (optional)      - sizes attribute, default "100vw"
    widths (optional)     - comma string of widths, default "400,600,900,1200,1600,2000"
    class (optional)
    loading (optional)    - "eager" | "lazy" (default "lazy")
    fetchpriority (optional) - "high" | "low" | "auto"
    alt (optional)        - overrides image.alt
{%- endcomment -%}
{%- liquid
  assign widths_str = widths | default: '400,600,900,1200,1600,2000'
  assign width_list = widths_str | split: ','
  assign img_sizes = sizes | default: '100vw'
  assign img_loading = loading | default: 'lazy'
  assign img_alt = alt | default: image.alt | default: ''
  assign aspect = image.aspect_ratio | default: 1
-%}
{%- if image -%}
  <img
    class="{{ class }}"
    src="{{ image | image_url: width: 800 }}"
    srcset="
      {%- for w in width_list -%}
        {{ image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
      {%- endfor -%}
    "
    sizes="{{ img_sizes }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    alt="{{ img_alt | escape }}"
    loading="{{ img_loading }}"
    {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
    decoding="async"
  >
{%- else -%}
  <div class="{{ class }}" style="aspect-ratio: {{ aspect }}; background: var(--c-ash-deep);" role="img" aria-label="{{ img_alt | escape }}"></div>
{%- endif -%}
