<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <meta name="robots" content="noindex,nofollow">
    {{ content_for_header }}
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>
      .password-page {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: var(--s-8);
        background: var(--c-char);
        color: var(--c-ash);
      }
      .password-page__mark {
        font-family: var(--f-display);
        font-size: var(--step-3);
        margin-bottom: var(--s-2);
      }
      .password-page__tag {
        color: var(--c-lime);
        font-size: var(--step-0);
        margin-bottom: var(--s-8);
        max-width: 44ch;
      }
      .password-page__form {
        display: flex;
        gap: var(--s-2);
        flex-wrap: wrap;
        justify-content: center;
      }
      .password-page__form input[type='password'] {
        min-height: 44px;
        padding: var(--s-2) var(--s-3);
        border: 1px solid var(--c-smoke);
        border-radius: var(--radius);
        background: var(--c-ash);
        color: var(--c-char);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#PasswordForm">{{ 'general.skip_to_content' | t }}</a>
    <div class="password-page">
      <p class="password-page__mark">{{ shop.name }}</p>
      <p class="password-page__tag">{{ 'password_page.tagline' | t }}</p>

      {% form 'storefront_password' %}
        {%- if form.errors -%}
          <p role="alert">{{ 'password_page.wrong_password' | t }}</p>
        {%- endif -%}
        <div id="PasswordForm" class="password-page__form">
          <label class="visually-hidden" for="Password">{{ 'password_page.password_label' | t }}</label>
          <input type="password" name="password" id="Password" placeholder="{{ 'password_page.password_label' | t }}" required>
          <button type="submit" class="button button--primary">{{ 'password_page.enter' | t }}</button>
        </div>
      {% endform %}

      {{ content_for_layout }}
    </div>
  </body>
</html>
