<section class="section" data-section-id="{{ section.id }}">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <div class="grid grid--4">
      {%- assign count = 0 -%}
      {%- for related_product in product.collections.first.products -%}
        {%- if related_product.id != product.id and count < section.settings.products_to_show -%}
          {%- render 'sauce-card', product: related_product -%}
          {%- assign count = count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.related_products.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.related_products.heading",
      "default": "You might also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.related_products.products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
