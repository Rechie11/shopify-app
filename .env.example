# Copy to .env and fill in. Every variable is validated with zod at boot in
# app/server/src/config/env.ts - the server refuses to start if one is
# missing or malformed.

NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://ember:ember@localhost:3306/ember_ash

# From the Partner dashboard, after `npm run dev` creates the app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,write_discounts,write_products

# Same value as SHOPIFY_API_KEY, re-exposed to the admin UI build (Vite only
# exposes VITE_-prefixed vars to client code). The API key is not a secret -
# it's public in every embedded app's iframe URL.
VITE_SHOPIFY_API_KEY=

# The CLI prints this tunnel URL each time `npm run dev` starts
SHOPIFY_APP_URL=

SHOPIFY_API_VERSION=2026-07

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

LOG_LEVEL=info

# Bundle Health Score margin config (basis points)
SCORE_MARGIN_FLOOR_BPS=3000
SCORE_MARGIN_TARGET_BPS=5500
